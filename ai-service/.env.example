# ISML AI Service Configuration
PROJECT_NAME="ISML AI Service"
VERSION="1.0.0"
ENVIRONMENT="development"
PORT=8000
DEBUG=true

# NestJS Backend Service Base URL (Authoritative Domain Master)
BACKEND_API_URL="http://localhost:3001/api/v1"

# Gemini LLM Provider Credentials
LLM_PROVIDER="gemini"
LLM_MODEL="gemini-flash-lite-latest"
GEMINI_API_KEY="your-gemini-api-key-here"

# Optional Search Provider Credentials
SERPER_API_KEY=""
BING_SEARCH_API_KEY=""
